{
  "name": "will-of-fire-desktop",
  "productName": "Hidden Ember",
  "version": "0.4.0",
  "description": "Hidden Ember. Desktop app wrapper (Mac App Store, and Windows if wanted).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac dir",
    "mas": "electron-builder --mac mas"
  },
  "build": {
    "appId": "io.github.ravikiranpanchal.willoffire",
    "productName": "Hidden Ember",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "www/**"
    ],
    "mac": {
      "category": "public.app-category.action-games",
      "icon": "icon.png",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Optional. Lets you cast jutsu with real hand signs. Video is read on this Mac only and is never saved or sent.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.action-games"
      }
    },
    "mas": {
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "entitlements.mas.plist",
      "entitlementsInherit": "entitlements.mas.inherit.plist",
      "provisioningProfile": "embedded.provisionprofile"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
